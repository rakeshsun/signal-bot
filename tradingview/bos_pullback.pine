//@version=6
// BOS Pullback - break of structure that must come back and retest the broken level,
// then break the new extreme to confirm. Own implementation of the concept (not LuxAlgo code).
//
// Bullish (bearish is the mirror image):
//   1. Break   - a bar CLOSES above the last swing high by at least "Minimum initial break".
//   2. Wait    - at least "Minimum bars before retest" bars must pass; a touch sooner kills the setup.
//   3. Retest  - price comes back and touches the broken level -> "Valid pullback" + touch circle.
//   4. Confirm - a bar closes above the high made after the break -> "BOS ▲" (entry signal).
//   Invalid    - a close more than "Close invalidation tolerance" back below the level, or the
//                setup is older than "Maximum setup age".
// Optional trade levels: entry = confirmation close, stop = pullback low, target = R multiple.
// Defaults tuned for gold (GC / GOLD) on the 5-minute chart: 1-year test on GC 5m, after costs,
// 93 trades, 56% wins, profit factor 1.61, profitable in both halves. Did not work on 15m.
indicator("BOS Pullback", overlay = true, max_labels_count = 500, max_lines_count = 500)

// ───────── inputs ─────────
gS = "Structure"
leftBars    = input.int(5,   "Swing left bars",                   minval = 1, group = gS)
rightBars   = input.int(5,   "Swing right bars",                  minval = 1, group = gS)
lookback    = input.int(150, "Structure lookback (bars)",         minval = 10, group = gS)
minBreakPt  = input.float(0.5, "Minimum initial break (points)",   minval = 0, step = 0.1, group = gS)
minBars     = input.int(6,   "Minimum bars before retest",        minval = 0, group = gS)
touchPt     = input.float(0.0, "Retest touch tolerance (points)", minval = 0, step = 0.1, group = gS, tooltip = "Counts a near-miss within this many points as a touch")
invalPt     = input.float(8.0, "Close invalidation tolerance (points)", minval = 0, step = 0.5, group = gS)
maxAge      = input.int(30,  "Maximum setup age (bars)",          minval = 5, group = gS)

gT = "Trade levels"
showTrade   = input.bool(true, "Show entry / stop / target", group = gT)
rr          = input.float(1.5, "Target (R multiple)", minval = 0.25, step = 0.25, group = gT)
stopPadPt   = input.float(0.5, "Stop padding (points)", minval = 0, step = 0.1, group = gT)
tradeLen    = input.int(20,  "Line length (bars)",   minval = 3, group = gT)

gV = "Style"
showRefs    = input.bool(true, "Show previous highs / lows", group = gV)
showDev     = input.bool(true, "Show developing (broken) levels", group = gV)
showText    = input.bool(true, "Show 'Valid pullback' text", group = gV)
showTouch   = input.bool(true, "Show touch circle", group = gV)
cHi         = input.color(color.new(color.gray, 30), "Previous high", group = gV)
cLo         = input.color(color.new(color.gray, 30), "Previous low",  group = gV)
cBull       = input.color(color.teal, "Bullish BOS", group = gV)
cBear       = input.color(color.red,  "Bearish BOS", group = gV)

// ───────── swing points ─────────
ph = ta.pivothigh(high, leftBars, rightBars)
pl = ta.pivotlow(low, leftBars, rightBars)

var float refHi = na
var int   refHiBar = na
var bool  refHiUsed = false
var float refLo = na
var int   refLoBar = na
var bool  refLoUsed = false

if not na(ph)
    refHi := ph
    refHiBar := bar_index - rightBars
    refHiUsed := false
if not na(pl)
    refLo := pl
    refLoBar := bar_index - rightBars
    refLoUsed := false
if not na(refHiBar) and bar_index - refHiBar > lookback
    refHi := na
if not na(refLoBar) and bar_index - refLoBar > lookback
    refLo := na

plot(showRefs ? refHi : na, "Previous high", cHi, 1, plot.style_linebr)
plot(showRefs ? refLo : na, "Previous low",  cLo, 1, plot.style_linebr)

// ───────── trade level drawing ─────────
drawTrade(int dir, float entry, float stop) =>
    risk = math.abs(entry - stop)
    tgt = entry + dir * rr * risk
    x2 = bar_index + tradeLen
    line.new(bar_index, entry, x2, entry, color = color.blue, width = 2)
    line.new(bar_index, stop,  x2, stop,  color = color.red,  width = 2)
    line.new(bar_index, tgt,   x2, tgt,   color = color.green, width = 2)
    label.new(x2, entry, "Entry " + str.tostring(entry, format.mintick), style = label.style_label_left, color = color.new(color.blue, 80), textcolor = color.blue, size = size.small)
    label.new(x2, stop,  "SL " + str.tostring(stop, format.mintick),     style = label.style_label_left, color = color.new(color.red, 80),  textcolor = color.red,  size = size.small)
    label.new(x2, tgt,   "TP " + str.tostring(tgt, format.mintick),      style = label.style_label_left, color = color.new(color.green, 80), textcolor = color.green, size = size.small)
    tgt

// ───────── bullish state machine ─────────
var int   bState = 0          // 0 idle, 1 broken (waiting for retest), 2 retested (waiting for confirmation)
var float bLevel = na
var int   bBreakBar = na
var float bExt = na           // highest high since the break
var float bPull = na          // lowest low of the pullback
var line  bLine = na

bullTouch = false
bullConf = false
bullEntry = float(na)
bullStop = float(na)
bullTgt = float(na)

if bState == 0
    if not na(refHi) and not refHiUsed and close > refHi + minBreakPt
        bState := 1
        bLevel := refHi
        bBreakBar := bar_index
        bExt := high
        refHiUsed := true
        if showDev
            bLine := line.new(refHiBar, bLevel, bar_index, bLevel, color = cBull, style = line.style_dashed)
else
    age = bar_index - bBreakBar
    if close < bLevel - invalPt or age > maxAge
        bState := 0
        line.delete(bLine)
    else if bState == 1
        if low <= bLevel + touchPt
            if age >= minBars
                bState := 2
                bPull := low
                bullTouch := true
                if showText
                    label.new(bar_index, low, "Valid pullback", style = label.style_label_up, color = color.new(cBull, 85), textcolor = cBull, size = size.small)
            else
                bState := 0
                line.delete(bLine)
        else
            bExt := math.max(bExt, high)
    else if bState == 2
        bPull := math.min(bPull, low)
        if close > bExt
            bullConf := true
            bullEntry := close
            bullStop := bPull - stopPadPt
            label.new(bar_index, low, "BOS ▲", style = label.style_label_up, color = cBull, textcolor = color.white, size = size.small)
            if showTrade
                bullTgt := drawTrade(1, bullEntry, bullStop)
            else
                bullTgt := bullEntry + rr * (bullEntry - bullStop)
            bState := 0
    if bState != 0 and showDev
        line.set_x2(bLine, bar_index)

// ───────── bearish state machine ─────────
var int   sState = 0
var float sLevel = na
var int   sBreakBar = na
var float sExt = na           // lowest low since the break
var float sPull = na          // highest high of the pullback
var line  sLine = na

bearTouch = false
bearConf = false
bearEntry = float(na)
bearStop = float(na)
bearTgt = float(na)

if sState == 0
    if not na(refLo) and not refLoUsed and close < refLo - minBreakPt
        sState := 1
        sLevel := refLo
        sBreakBar := bar_index
        sExt := low
        refLoUsed := true
        if showDev
            sLine := line.new(refLoBar, sLevel, bar_index, sLevel, color = cBear, style = line.style_dashed)
else
    age = bar_index - sBreakBar
    if close > sLevel + invalPt or age > maxAge
        sState := 0
        line.delete(sLine)
    else if sState == 1
        if high >= sLevel - touchPt
            if age >= minBars
                sState := 2
                sPull := high
                bearTouch := true
                if showText
                    label.new(bar_index, high, "Valid pullback", style = label.style_label_down, color = color.new(cBear, 85), textcolor = cBear, size = size.small)
            else
                sState := 0
                line.delete(sLine)
        else
            sExt := math.min(sExt, low)
    else if sState == 2
        sPull := math.max(sPull, high)
        if close < sExt
            bearConf := true
            bearEntry := close
            bearStop := sPull + stopPadPt
            label.new(bar_index, high, "BOS ▼", style = label.style_label_down, color = cBear, textcolor = color.white, size = size.small)
            if showTrade
                bearTgt := drawTrade(-1, bearEntry, bearStop)
            else
                bearTgt := bearEntry - rr * (bearStop - bearEntry)
            sState := 0
    if sState != 0 and showDev
        line.set_x2(sLine, bar_index)

// ───────── touch circles ─────────
plotshape(showTouch and bullTouch, "Bullish retest", shape.circle, location.belowbar, cBull, size = size.tiny)
plotshape(showTouch and bearTouch, "Bearish retest", shape.circle, location.abovebar, cBear, size = size.tiny)

// ───────── alerts ─────────
alertcondition(bullConf, "BOS ▲ confirmed", "BOS pullback BUY on {{ticker}} at {{close}}")
alertcondition(bearConf, "BOS ▼ confirmed", "BOS pullback SELL on {{ticker}} at {{close}}")
alertcondition(bullTouch or bearTouch, "Valid pullback (retest)", "BOS retest on {{ticker}} at {{close}}")

if bullConf
    alert("BUY " + str.tostring(bullEntry, format.mintick) + " | SL " + str.tostring(bullStop, format.mintick) + " | TP " + str.tostring(bullTgt, format.mintick) + " | " + syminfo.ticker + " BOS pullback", alert.freq_once_per_bar_close)
if bearConf
    alert("SELL " + str.tostring(bearEntry, format.mintick) + " | SL " + str.tostring(bearStop, format.mintick) + " | TP " + str.tostring(bearTgt, format.mintick) + " | " + syminfo.ticker + " BOS pullback", alert.freq_once_per_bar_close)
